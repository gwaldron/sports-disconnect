{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sports-disconnect",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "94eacb8c29a644168c0fee0e14ef2012" }
  ],
  // Change log: the last-seen version of every match plus a history of changes.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sports-disconnect",
      "database_id": "2852c3a6-7b55-4845-9c5c-ae05acf3a8ef",
      "migrations_dir": "migrations"
    }
  ],
  // No timer: the schedule refreshes when someone loads the page. (An empty
  // list, rather than no "triggers" key, is what removes a deployed cron.)
  "triggers": {
    "crons": []
  },
  // Any SportsConnect site works: add SC_SITE (and SC_MAP_HINT) here. See README.
  "vars": {
    "SC_PORTAL_ID": "52092",
    "SC_LEAGUE_NAME": "Fairfax Little League",
    // Assignr sign-in (umpires). The secret is stored separately:
    //   npx wrangler secret put ASSIGNR_CLIENT_SECRET
    "ASSIGNR_CLIENT_ID": "me_HF7WpOvqKMPVwcjnRAK9EiJ14lWKykNxUL29JuaU"
  },
  "observability": {
    "enabled": true
  }
}
